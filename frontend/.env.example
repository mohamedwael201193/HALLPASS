# HALLPASS frontend — environment template.
# Copy to .env and fill in. `npm install && npm run dev` works WITHOUT any
# of these (landing renders fully; wallet-gated actions disable themselves
# with a stated reason until configured).

# --- Wallet (Reown AppKit) -----------------------------------------------
# REQUIRED for Connect / install / revoke. Get one at https://cloud.reown.com.
# Without it, the connect button renders disabled with an explanation —
# nothing is simulated.
VITE_REOWN_PROJECT_ID=

# --- Backend API ------------------------------------------------------------
# Base URL of the hallpass-api (backend/api/server.js). Same-origin default:
# leave empty when the API is served from the same host. The dashboard reads
# GET /api/v1/* (see backend/api/CONTRACT.md); every endpoint degrades
# honestly when the backend is absent.
VITE_API_BASE_URL=

# --- Chain ------------------------------------------------------------------
# Arc mainnet RPC for direct chain reads (viem/wagmi). Defaults to the
# public endpoint baked into src/lib/wagmi.ts; override only if needed.
VITE_RPC_URL=

# --- Contracts (Arc mainnet, chain 5042) ------------------------------------
# HallpassPlugin deployment. Env ONLY — there is deliberately NO fallback
# default: installing the wrong plugin address is security-relevant, so a
# missing address surfaces as a disabled Install button with a reason,
# never a silent fallback. Set AFTER Sourcify exact_match verification
# (see contracts/DEPLOYMENT.md §4).
VITE_PLUGIN_ADDRESS=

# keccak256(abi.encode(plugin.pluginManifest())) for the deployed plugin.
# Deploy-time reference; the app recomputes it at runtime and a mismatch
# is treated as a hard error.
VITE_PLUGIN_MANIFEST_HASH=

# EntryPoint v0.7 (canonical singleton). Override for disaster recovery only.
VITE_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# --- Relay (optional) --------------------------------------------------------
# Backend userOp relay. NOT implemented yet — the dashboard self-relays via
# submitUserOpDirect (see src/lib/userops.ts). Leave empty.
VITE_RELAY_URL=

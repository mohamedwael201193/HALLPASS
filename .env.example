# HALLPASS — environment variables (KEY NAMES AND PLACEHOLDERS ONLY).
# Copy to .env and fill in. NEVER commit a filled .env, NEVER print values.
# PUBLIC = safe to share / bake into client config.
# SECRET = never commit, never print, never log.

# --- PUBLIC ---
RPC_URL=                 # PUBLIC — Arc mainnet RPC. Public endpoint: https://rpc.mainnet.arc.io
                         # (third-party alternatives: Alchemy / Blockdaemon / dRPC / QuickNode Arc endpoints)
PLUGIN_ADDRESS=          # PUBLIC — HallpassPlugin deployment address on Arc 5042.
                         # Get from the deploy step (§5.2 of hallpass-build-bible.md); confirm Sourcify exact_match.
ENTRYPOINT_ADDRESS=      # PUBLIC — ERC-4337 v0.7 EntryPoint on Arc 5042.
                         # Verified on-chain: 0x0000000071727De22E5E9d8BAf0edAc6f37da032
PORT=                    # PUBLIC — API listen port. Render injects this automatically; set locally e.g. 8787.
FRONTEND_URL=            # PUBLIC — Dashboard origin for CORS, e.g. https://hallpass.example.com

# --- ENVIRONMENT-SPECIFIC (not secret, but machine-local) ---
DB_PATH=                 # LOCAL — sqlite file path, e.g. ./data/hallpass.db.
                         # On Render this points at the attached disk (/var/data/hallpass.db); see backend/render.yaml.

# --- SECRET ---
RELAYER_PRIVATE_KEY=     # SECRET — key used by the relay service to submit EntryPoint.handleOps
                         # (self-relayed; no public v0.7 bundler exists on Arc). Fund with USDC for gas.
                         # Generate: cast wallet new  (or viem generatePrivateKeyAccount). Show once, store once.
